APP_ENV=production
APP_URL=https://leadpilot.webrayz.com
APP_ALLOWED_ORIGINS=https://leadpilot.webrayz.com
APP_KEY=base64:REPLACE_WITH_32_RANDOM_BYTES_AS_BASE64
COOKIE_SECURE=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=YOUR_HOSTINGER_DATABASE_NAME
DB_USER=YOUR_HOSTINGER_DATABASE_USER
DB_PASSWORD=replace-me

PLATFORM_SMTP_HOST=smtp.hostinger.com
PLATFORM_SMTP_PORT=465
PLATFORM_SMTP_ENCRYPTION=ssl
PLATFORM_SMTP_USERNAME=YOUR_HOSTINGER_EMAIL
PLATFORM_SMTP_PASSWORD=YOUR_HOSTINGER_EMAIL_PASSWORD
PLATFORM_FROM_EMAIL=YOUR_HOSTINGER_EMAIL
PLATFORM_FROM_NAME=LeadPilot

# Use the absolute path outside public_html on Hostinger.
STORAGE_PATH=/home/YOUR_HOSTINGER_USER/domains/leadpilot.webrayz.com/storage

QUEUE_BATCH_SIZE=50
MAX_GROUP_RECIPIENTS=100000
BOUNCE_PAUSE_MIN=20
BOUNCE_PAUSE_PERCENT=20
IMPORT_BATCH_SIZE=250
MAX_IMPORT_BYTES=20971520
MAX_IMPORT_ROWS=100000
